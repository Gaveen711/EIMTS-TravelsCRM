# Copy to .env.local. Never commit real keys or passwords.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial administrator: choose a unique password with at least 12 characters.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Agency Administrator

# Optional business email, implemented in Phase 8.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Temporary development-only admin / 2001 login. Disabled in production.
CRM_LOCAL_LOGIN=false
# Generate a random private signing secret if enabling local preview.
CRM_LOCAL_SESSION_SECRET=
