# Copy to .env.local. Keep all real secrets out of Git.
# Local development opens the CRM without login; production always requires identity.
CRM_DEFER_AUTH=true
# Optional local data directory; default .crm-data persists between development runs.
CRM_LOCAL_DATA_DIR=.crm-data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only by explicit Admin provisioning in the final access stage.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Agency Administrator

# Optional customer document email. Missing configuration fails gracefully.
RESEND_API_KEY=
EMAIL_FROM=
